#!/bin/sh
# Block pushes that would update protected branches (main).

protected_branch="^(main)$"

while read -r local_ref local_sha remote_ref remote_sha; do
	branch=$(echo "$remote_ref" | sed -n 's#^refs/heads/##p')
	if echo "$branch" | grep -Eq "$protected_branch"; then
		echo "Push to '$branch' is blocked by the pre-push hook." >&2
		echo "Use a feature branch and open a pull request instead." >&2
		exit 1
	fi
done

exit 0
